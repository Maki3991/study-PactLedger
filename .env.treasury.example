# KaleidoX execution mode: mock | testnet
INJECTIVE_EXECUTION_MODE=mock

# Injective testnet public endpoints
INJECTIVE_NETWORK=testnet
INJECTIVE_CHAIN_ID=injective-888
INJECTIVE_RPC_ENDPOINT=https://testnet.sentry.tm.injective.network:443
INJECTIVE_REST_ENDPOINT=https://testnet.sentry.lcd.injective.network:443
INJECTIVE_GRPC_ENDPOINT=https://testnet.sentry.chain.grpc-web.injective.network:443
INJECTIVE_INDEXER_ENDPOINT=https://testnet.sentry.exchange.grpc-web.injective.network

# Server-side signer. Never expose these values through VITE_* variables.
INJECTIVE_WALLET_ADDRESS=
INJECTIVE_PRIVATE_KEY=

# Agent payment asset mapping and allowlisted recipients.
INJECTIVE_PAYMENT_DENOM=
INJECTIVE_PAYMENT_DECIMALS=
INJECTIVE_EXPLORER_TX_BASE_URL=https://testnet.explorer.injective.network/transaction/
INJECTIVE_RISK_PAYEE_ADDRESS=
INJECTIVE_EXECUTION_PAYEE_ADDRESS=
INJECTIVE_POOLMATE_MERCHANT_ADDRESS=

# Optional future Treasury contract. Direct MsgSend settlement does not require it.
INJECTIVE_CONTRACT_ADDRESS=

# Transaction defaults
INJECTIVE_FEE_DENOM=inj
INJECTIVE_GAS_PRICE=500000000

# Optional server settings
KALEIDOX_API_HOST=127.0.0.1
KALEIDOX_API_PORT=8787
KALEIDOX_SERVE_WEB=true
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Optional in Mock mode; required before accepting external A2A tasks in Testnet mode.
A2A_API_KEY=

# Optional server-side Telegram transport. Checkout remains Mock / No Chain.
TELEGRAM_BOT_TOKEN=

# Optional public Telegram group URL embedded at build time for the PoolMate demo.
VITE_POOLMATE_TELEGRAM_URL=

# PostgreSQL is required outside tests. DATABASE_URL can replace the fields below.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_treasury
POSTGRES_USER=agent_treasury
POSTGRES_PASSWORD=
POSTGRES_SSL=disable

# PandaData stock market provider: auto | panda | replay
PANDA_DATA_MODE=auto
# A mainland mobile number is normalized to the PandaData 86xxxxxxxxxxx username form.
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=
PANDA_DATA_BASE_URL=http://pandadata.pandaaiquant.com
PANDA_DATA_DEFAULT_SYMBOL=000001.SZ
PANDA_DATA_TIMEOUT_MS=45000
# Windows local: .venv/Scripts/python.exe
# Linux local: .venv/bin/python
# Docker image: /opt/panda-venv/bin/python
PANDA_PYTHON_BIN=

# Competition primary model: DeepSeek V4 Pro.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Volcano Ark fallback when no DeepSeek token is configured.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PANDA_MODEL_ENDPOINT_ID=ep-20260708162855-pcf9x
PANDA_MODEL_TIMEOUT_MS=45000


# --- Injective Treasury Integration ---
# 测试网配置（默认已经配置好，可以直接使用）
INJECTIVE_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_CHAIN_ID=1439
INJECTIVE_EXPLORER_URL=https://testnet.blockscout.injective.network

# 已部署的合约地址（默认已经配置了测试网地址，不需要修改）
INJECTIVE_SETTLEMENT_GATEWAY=0x157f4a11C59d7AE4fC2e20e121df8ea396a0c4e1
INJECTIVE_AGENT_TREASURY=0x8E095A6B47D3883f647A1014a022729338A96bb9
INJECTIVE_USDC_TOKEN=0xcbf90cf717BC05eBC2D601946cD03a518fFFED27
INJECTIVE_GATEWAY_SIGNER=0x0461CaC51CD69196159EDFE02233Ac361e218881
INJECTIVE_DEMO_AGENT=0x33C9c60503fDc3dE476cf9FC597ce6A2203e53bC
INJECTIVE_MERCHANT_TREASURY=0xAA213Af5D85bC34e6F0639cF963b961AF0ab90E5

# 可选：配置私钥用于发送真实交易（测试网使用，不要提交到Git）
# INJECTIVE_PRIVATE_KEY=your_private_key_here
