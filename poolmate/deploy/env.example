# Public ports and URLs
POOLMATE_BACKEND_PORT=8788
POOLMATE_FRONTEND_PORT=8080
# Required for Telegram WebApp links: external HTTPS frontend origin.
POOLMATE_PUBLIC_BASE_URL=https://poolmate.example.com
VITE_POOLMATE_API_BASE_URL=

# Backend-only credentials. Never expose these with a VITE_ prefix.
POOLMATE_ADMIN_API_KEY=
POOLMATE_SPONSORED_PAYER_REF=poolmate-sponsored-demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ALLOWLIST_ENABLED=false
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_PROXY_URL=

# Natural-language draft extraction. Setting only AIPING_API_KEY enables the
# ordinary DeepSeek-V3.2 model through the AIPing OpenAI-compatible endpoint.
AIPING_API_KEY=
AIPING_BASE_URL=https://aiping.cn/api/v1
AIPING_MODEL=DeepSeek-V3.2
# Official DeepSeek and POOLMATE_LLM_* remain optional alternatives/overrides.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
POOLMATE_LLM_ENABLED=
POOLMATE_LLM_PROVIDER=deepseek
POOLMATE_LLM_BASE_URL=
POOLMATE_LLM_API_KEY=
POOLMATE_LLM_MODEL=
POOLMATE_LLM_TIMEOUT_MS=30000
POOLMATE_LLM_MAX_INPUT_CHARS=2000

PAYMENT_BASE_URL=
PAYMENT_BASE_API_KEY=
# mock uses the local persisted Payment Base; testnet/live require the HTTP fields.
PAYMENT_SETTLEMENT_MODE=disabled
PAYMENT_BASE_SUBMIT_PATH=
PAYMENT_BASE_RECOVER_PATH=
PAYMENT_BASE_TIMEOUT_MS=10000
