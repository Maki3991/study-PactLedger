# Public ports and URLs
POOLMATE_BACKEND_PORT=8788
POOLMATE_FRONTEND_PORT=8080
# Required for Telegram WebApp links: external HTTPS frontend origin.
POOLMATE_PUBLIC_BASE_URL=https://poolmate.example.com
VITE_POOLMATE_API_BASE_URL=

# Backend-only credentials. Never expose these with a VITE_ prefix.
POOLMATE_ADMIN_API_KEY=
POOLMATE_SPONSORED_PAYER_REF=poolmate-sponsored-demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_PROXY_URL=
PAYMENT_BASE_URL=
PAYMENT_BASE_API_KEY=
PAYMENT_SETTLEMENT_MODE=disabled
PAYMENT_BASE_SUBMIT_PATH=
PAYMENT_BASE_RECOVER_PATH=
PAYMENT_BASE_TIMEOUT_MS=10000
