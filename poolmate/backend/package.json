{
  "name": "@poolmate/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Independent PoolMate API, grammY bot, and deterministic application runtime.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../shared run build && tsc -p tsconfig.build.json",
    "check": "npm run typecheck",
    "typecheck": "npm --prefix ../shared run build && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts eslint.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx scripts/migrate.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run healthcheck && npm run audit:prod"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.114.0",
    "@poolmate/shared": "file:../shared",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.2",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^4.1.1"
  }
}
