# PostgreSQL – copy to .env and fill in values
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# Server
PORT=8787

# DeepSeek V4 Pro (get token from PandaAI / DeepSeek official)
# Leave blank to run in demo mode (no real AI calls)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# A2A public URL – set this to your ngrok/deploy URL for PandaAI submission
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8787
